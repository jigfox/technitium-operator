# The Secret a TechnitiumServer's credentialsSecretRef points at, in the same
# namespace as the TechnitiumServer. Not part of the kustomization.
apiVersion: v1
kind: Secret
metadata:
  name: technitium-credentials
stringData:
  username: admin          # or set credentialsSecretRef.username
  password: change-me
  # token: <API token>     # with credentialsSecretRef.tokenKey: token
